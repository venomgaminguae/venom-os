# VENOM — example environment file
# ===================================================================
# EVERY variable the code reads is listed below, commented out and with NO
# value. Defaults are given in the comment above each one. Everything is
# optional: VENOM runs with an empty file. The bridge authenticates with your
# own Claude Code login, and voice in and out fall back to on-device engines.
#
# Two audiences read these variables:
#   - the BRIDGE and the TEAM CONNECTOR (Node: bridge/server.mjs,
#     hermes-mcp/*.mjs) read them from the environment of the shell that starts
#     them. They do not read any .env file themselves: export them, or set them
#     in Venom.cmd / venom-app.ps1.
#   - the FRONTEND (the Vite app) reads only VITE_* variables, from .env.local
#     (copy this file to .env.local). Only VITE_-prefixed values ever reach the
#     browser, so never put a secret you care about in a VITE_* variable.
# Never commit a real key. .env and .env.* are git-ignored (except this file).


# ===================================================================
# BRAIN / BRIDGE (bridge/server.mjs)
# ===================================================================

# Port the bridge listens on (WebSocket + a few HTTP endpoints). Default 8787.
# If you change it, change VITE_BRIDGE_URL to match.
# VENOM_BRIDGE_PORT=

# Interface the bridge listens on. Default 127.0.0.1 (this machine only).
# Anything else puts the agent on your network; don't, unless you have put your
# own authentication in front of it.
# VENOM_BRIDGE_HOST=

# Extra hostnames the bridge answers to, comma separated. Requests addressed to
# any other name are refused, which is what stops DNS rebinding. Default: none
# beyond localhost, 127.0.0.1 and [::1].
# VENOM_ALLOWED_HOSTS=

# Extra browser origins allowed to open the agent WebSocket, comma separated.
# Local dev origins are already allowed. Default: none.
# VENOM_ALLOWED_ORIGINS=

# 1 = allow clients that send no Origin header at all (curl, scripts, native
# apps). Default 0, because that is also what local malware looks like.
# VENOM_ALLOW_NO_ORIGIN=

# The Claude model the bridge asks Claude Code to run. Default: appModel in
# venom.config.json (npm run setup asks for it), else none, which means Claude
# Code's own default for the signed-in account.
# VENOM_MODEL=

# Reasoning effort passed to Claude Code. Default high.
# VENOM_EFFORT=

# 1 = allow effectful tools (send, tap, delete, install, pay). Default 0, so
# VENOM can look at anything and change nothing. `npm run bridge:writes` (the
# --writes flag) turns it on. Read the decideTool gate in bridge/policy.mjs first.
# VENOM_ALLOW_WRITES=

# Which MCP servers from ~/.claude.json VENOM gets, comma separated. Unset
# passes every configured server; an empty value passes none. Default: all.
# VENOM_MCP_SERVERS=

# 1 = also let the connectors attached to your claude.ai account (mail, drive,
# calendar ...) into the session. Default 0.
# VENOM_ACCOUNT_CONNECTORS=

# Built-in capabilities to leave out, comma separated: browser (your own
# signed-in Chrome), camera, interface (the ui_* retinting tools). Default: none.
# VENOM_DISABLE=

# The agent's working directory. File tools are confined to it, the system temp
# directory and VENOM_FILE_ROOTS; credential locations are refused even there.
# Default ~/.venom/workspace.
# VENOM_WORKSPACE=

# Extra directories the file tools may use and the /file endpoint may serve
# images from, comma separated. Default: none.
# VENOM_FILE_ROOTS=

# 1 = keep a transcript of every session under ~/.claude/projects, the way
# Claude Code does. Default 0 (they hold every tool result verbatim).
# VENOM_KEEP_TRANSCRIPTS=

# Run the agent (the Claude Code CLI the SDK starts) through this executable
# instead of the bundled one, typically a sandbox wrapper. Default: the bundled CLI.
# VENOM_CLAUDE_EXECUTABLE=

# 1 = log every agent message, tool call and connected MCP server to the
# bridge's terminal. Debugging only. Default 0.
# VENOM_DEBUG=

# Port of the Vite dev server (vite.config.ts; scripts/start.mjs waits on it).
# Default 5173. The bridge only accepts origins on 5173-5199 and 4173-4199.
# PORT=

# Note: Venom.cmd and venom-app.ps1 CLEAR ANTHROPIC_API_KEY, ANTHROPIC_BASE_URL
# and CLAUDECODE (the .ps1 every ANTHROPIC*/CLAUDE* variable) so that your own
# Claude Code login is used. The team connector strips the same ones from its
# child processes.


# ===================================================================
# TEAM CONNECTOR (hermes-mcp/runner.mjs, hermes-mcp/runfiles.mjs)
# ===================================================================

# Path to the Hermes agent executable. Default %LOCALAPPDATA%\hermes\bin\hermes.exe.
# HERMES_EXE=

# Working directory for Hermes jobs. Default: the connector's current directory.
# HERMES_WORKDIR=

# Per-job time limit in milliseconds. Default 1200000 (20 minutes).
# HERMES_TIMEOUT_MS=

# Path to the Antigravity CLI (the Gemini team member). Default
# %LOCALAPPDATA%\agy\bin\agy.exe. GEMINI_API_KEY, GOOGLE_API_KEY,
# GOOGLE_GENAI_USE_VERTEXAI and GOOGLE_CLOUD_PROJECT are removed from its
# environment so it uses your Google sign-in.
# AGY_EXE=

# Model for the Antigravity agent, for example AGY_MODEL=<model-slug> (list
# them with `agy models`). Default: none, so Antigravity uses its own default.
# AGY_MODEL=

# Path to the Claude Code CLI used for the team's Claude Code agents. Default
# %USERPROFILE%\.local\bin\claude.exe.
# TEAM_CLAUDE_EXE=

# Model for the team's Claude Code agents. Default: empty (the CLI's own default).
# TEAM_CLAUDE_MODEL=

# Folder the team's project jobs live under. Default %USERPROFILE%\Projects
# (or $HOME/Projects).
# PROJECTS_ROOT=

# Folder for the agents' run files and activity log. Default ~/.venom/agents.
# VENOM_AGENTS_DIR=

# 0 = do not write the agents' activity log (activity.jsonl). Default 1 (on).
# VENOM_AGENT_ACTIVITY=


# ===================================================================
# VOICE OUT: Kokoro (default), system voice (fallback), ElevenLabs (optional)
# ===================================================================

# Browser text-to-speech engine. Default kokoro.
#   kokoro: neural voice running in the browser (model downloaded once from
#           Hugging Face, onnx-community/Kokoro-82M-v1.0-ONNX). The system
#           voice speaks while it loads, or if it cannot load.
#   system: the browser's built-in speechSynthesis. Instant, on-device.
# VITE_TTS_ENGINE=

# Kokoro voice, when VITE_TTS_ENGINE=kokoro. Default bm_george.
# VITE_KOKORO_VOICE=

# Kokoro weights precision: q8 | fp32 | fp16 | q4. Default q8 (about 86 MB);
# fp32 is about 330 MB.
# VITE_KOKORO_DTYPE=

# true = prefer the ElevenLabs voice in the browser when a key is available.
# Default false.
# VITE_USE_ELEVENLABS=

# ElevenLabs API key for the bridge. Optional: with it VENOM can speak in an
# ElevenLabs voice and transcribe with ElevenLabs Scribe. If an elevenlabs MCP
# server is configured in ~/.claude.json the bridge reads the key from there.
# `npm run setup` checks for it. Default: none.
# ELEVENLABS_API_KEY=

# ElevenLabs voice id for the bridge's speech endpoint. Default
# JBFqnCBsd6RMkjVDRZzb (ElevenLabs' public stock voice "George").
# VENOM_VOICE_ID=

# ElevenLabs key used directly by the browser (it ships to the page; demo use
# only). Default: none.
# VITE_ELEVENLABS_API_KEY=

# ElevenLabs voice id used by the browser. Default JBFqnCBsd6RMkjVDRZzb
# (public stock voice "George").
# VITE_ELEVENLABS_VOICE_ID=


# ===================================================================
# HEARING: speech-to-text (local Whisper on the bridge, or the browser)
# ===================================================================

# Speech input engine. Default auto.
#   auto:    the bridge's transcriber when it has one (local Whisper, else
#            ElevenLabs Scribe); otherwise Chrome's own recognition.
#   browser: always Chrome's recognition (audio goes to Google).
# VITE_STT_ENGINE=

# 1 = run local Whisper in the bridge (bridge/stt-local.mjs). Default 0 (off).
# VENOM_LOCAL_STT=

# Folder holding the Whisper model files (fetched separately, never committed).
# Default desktop/models in this repo.
# VENOM_STT_MODEL_DIR=

# Whisper model id inside that folder. Default onnx-community/whisper-base.en.
# VENOM_STT_MODEL=

# Inference device: dml (DirectML GPU encoder, CPU decoder) | cpu. Default dml,
# which falls back to cpu on its own; an explicit value is honoured as is.
# VENOM_STT_DEVICE=

# Weights precision, optionally encoder/decoder (e.g. fp32/q8). Default fp32.
# VENOM_STT_DTYPE=

# Device the worker falls back to if the first one fails. Set by the bridge
# itself (cpu when the default device is used); normally leave unset.
# VENOM_STT_FALLBACK=

# transformers.js cache folder for the worker. Default <system temp>/venom-stt-cache.
# VENOM_STT_CACHE_DIR=

# Any value = print the Whisper worker's errors to the bridge terminal. Default off.
# VENOM_STT_DEBUG=


# ===================================================================
# WAKE WORD
# ===================================================================

# Who listens for "Venom" when hearing is local. Default browser.
#   browser: Chrome recognition, only while dormant (reacts mid-word).
#   local:   local Whisper hears the wake word too; no audio goes to Google,
#            but waking is slower.
# VITE_WAKE_ROUTE=


# ===================================================================
# MICROPHONE
# ===================================================================

# Prefer the first audio input whose name contains this text. Default: none,
# so the browser's default microphone is used (or, if it hears nothing, the
# loudest input).
# Press M in the app to cycle inputs; that choice is remembered and wins.
# VITE_MIC_PREFER=


# ===================================================================
# MEMORY (bridge/memory.mjs)
# ===================================================================

# 0 = turn memory off (no recall, no conversation log). Default 1 (on).
# VENOM_MEMORY=

# Folder for VENOM's own conversation log. Default ~/.venom/memory.
# VENOM_MEMORY_DIR=

# Folder holding the shared MEMORY.md / USER.md notes. Default
# <HERMES_HOME>/memories.
# VENOM_HERMES_MEMORY_DIR=

# Hermes home folder, used to find the notes above. Default
# %LOCALAPPDATA%\hermes (or ~/AppData/Local/hermes).
# HERMES_HOME=

# Character budget for MEMORY.md. Default 2200.
# VENOM_MEMORY_LIMIT=

# Character budget for USER.md. Default 1375.
# VENOM_USER_LIMIT=

# Days of conversation log kept and searchable. Default 365.
# VENOM_MEMORY_DAYS=

# --- The HUD's memory section (bridge/memorysources.mjs, GET /memory/sources) ---

# Obsidian vault whose notes the memory section counts. Default: none (the row
# reads "not found" and nothing is looked for).
# VENOM_VAULT_DIR=

# Knowledge graph file whose nodes it counts. Default: this project's
# graphify-out/graph.json.
# VENOM_GRAPH_FILE=

# Hermes root folder whose skills it counts. Default: derived from HERMES_HOME
# (a profile's home points two levels up), else %LOCALAPPDATA%\hermes.
# VENOM_HERMES_ROOT=

# --- Optional long-term memory through Honcho (bridge/honcho.mjs) ---
# Off unless a key is found. With a key, each finished spoken turn is also
# sent to the Honcho service, so your words leave this machine.

# 0 = never use Honcho, even when a key is present. Default: on when a key exists.
# VENOM_HONCHO=

# Honcho API key. Also read from HONCHO_API_KEY, then from the .env file in
# the Hermes home folder. Never commit a real key. Default: none.
# VENOM_HONCHO_API_KEY=
# HONCHO_API_KEY=

# Honcho server. Default https://api.honcho.dev.
# VENOM_HONCHO_URL=

# Workspace, the assistant's peer and your peer. Defaults: the values in
# <HERMES_HOME>/honcho.json when it exists, else hermes / venom / owner.
# VENOM_HONCHO_WORKSPACE=
# VENOM_HONCHO_AI_PEER=
# VENOM_HONCHO_USER_PEER=

# Request timeout in milliseconds. Default 8000.
# VENOM_HONCHO_TIMEOUT_MS=

# How long a finished turn waits for a late interrupt before it is sent, in
# milliseconds. Default: see bridge/longmemory.mjs.
# VENOM_HONCHO_HOLD_MS=


# ===================================================================
# CHROME LAUNCH (scripts/open-window.mjs, scripts/start.mjs, bridge/chrome.mjs)
# ===================================================================

# Path to Google Chrome for the app window. Default
# C:\Program Files\Google\Chrome\Application\chrome.exe.
# VENOM_CHROME=

# 1 = open the app in a normal window instead of full screen. Default 0.
# VENOM_WINDOWED=

# WSL only: the Windows pipe the browser relay connects to. Default
# claude-mcp-browser-bridge- followed by your Windows user name.
# VENOM_CHROME_PIPE=


# ===================================================================
# CAMERA / HANDS
# ===================================================================
# No variables of its own. To leave the camera tools out for the agent, add
# camera to VENOM_DISABLE (see BRAIN / BRIDGE above).


# ===================================================================
# OWNER IDENTITY (also readable from venom.config.json in the repo root,
# which is git-ignored)
# ===================================================================

# How VENOM addresses and refers to you. Default: none (neutral wording).
# VENOM_OWNER_NAME=

# Your company or organisation, for context in the prompt. Default: none.
# VENOM_COMPANY=

# Your city, for weather and local-time context. Default: none.
# VENOM_CITY=

# Subtitle shown under the brand name in the HUD. Default: none.
# VITE_BRAND_SUB=

# Company name shown in the HUD. Default: none.
# VITE_OWNER_COMPANY=


# ===================================================================
# FRONTEND BRAIN SELECTION AND DIRECT MODE (src/config.ts)
# ===================================================================

# Which brain the browser talks to. Default bridge.
#   bridge: the local bridge (recommended; no API key, your MCP servers).
#   direct: the browser calls the Claude API itself; needs VITE_ANTHROPIC_API_KEY.
# VITE_BACKEND=

# Where the bridge listens. Default ws://localhost:8787 (keep in step with
# VENOM_BRIDGE_PORT).
# VITE_BRIDGE_URL=

# Anthropic API key. Direct mode only, and it ships to the browser. Default: none.
# VITE_ANTHROPIC_API_KEY=

# Claude model id for direct mode, for example VITE_ANTHROPIC_MODEL=<model-id>.
# Required in direct mode: there is no default. Not used with the bridge, which
# takes VENOM_MODEL or appModel in venom.config.json.
# VITE_ANTHROPIC_MODEL=

# Remote MCP servers for direct mode. Each is enabled only when set, and each
# token ships to the browser. Default: none.
# VITE_ZAPIER_MCP_URL=
# VITE_PIPEDREAM_MCP_URL=
# VITE_NOTION_TOKEN=
# VITE_LINEAR_TOKEN=
# VITE_GITHUB_TOKEN=
# VITE_STRIPE_TOKEN=
# VITE_SENTRY_TOKEN=
# VITE_HOMEASSISTANT_MCP_URL=
# VITE_HOMEASSISTANT_TOKEN=


# ===================================================================
# READ FROM THE OPERATING SYSTEM (do not set these here)
# ===================================================================
# LOCALAPPDATA, USERPROFILE, HOME: default folder locations (hermes-mcp,
# bridge/memory.mjs). WSL_DISTRO_NAME: detects WSL (bridge/chrome.mjs).
# import.meta.env.DEV: set by Vite in development (src/store.ts).


# ===================================================================
# PROOF SCRIPTS AND TESTS ONLY (scripts/*-proof*, scripts/fake-cli.mjs, test/)
# ===================================================================

# scripts/mic-proof.mjs: scratch folder. Default <system temp>/venom-mic-proof.
# MIC_PROOF_SCRATCH=
# scripts/mic-proof.vite.config.mjs: dev-server port and Vite cache folder
# (set by mic-proof.mjs).
# MIC_PROOF_PORT=
# MIC_PROOF_CACHE=

# scripts/voice-proof.mjs: scratch folder. Default <system temp>/venom-voice-proof.
# VOICE_PROOF_SCRATCH=
# scripts/voice-proof.*.mjs: server port and Vite cache folder (set by
# voice-proof.mjs).
# VOICE_PROOF_PORT=
# VOICE_PROOF_CACHE=

# scripts/fake-cli.mjs (stand-in Claude CLI for tests): file every stdin line
# is appended to (default: none); pause after the first sentence in ms
# (default 5000); gap between streamed money deltas in ms (default 60).
# FAKE_CLI_LOG=
# FAKE_CLI_PAUSE_MS=
# FAKE_CLI_DELTA_MS=

# test/stt-local.test.mjs: a WAV clip and a regex its transcript must match,
# for the optional real-model test (skipped when unset).
# VENOM_STT_TEST_CLIP=
# VENOM_STT_TEST_EXPECT=


# ===================================================================
# DESKTOP APP (desktop/main.mjs; read from the environment that starts the app)
# ===================================================================

# The app's own bridge port. Default 8788.
# VENOM_APP_BRIDGE_PORT=

# The app's page port. Default: the first free port of 4188-4199.
# VENOM_APP_PORT=

# Folder for the app's browser profile and logs. Default ~/.venom/desktop-app.
# VENOM_APP_DATA=

# Serve another built interface instead of the packaged dist (proofs).
# VENOM_APP_DIST=

# A node.exe to run the bridge with. Default: the app itself in Node mode.
# VENOM_APP_NODE=

# 1 = tests: Chromium muted, speech at volume 0, no error boxes. Default off.
# VENOM_APP_SILENT=

# 1 = a 1400x850 window instead of full screen. Default off.
# VENOM_WINDOWED=
