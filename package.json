{
  "name": "venom",
  "private": true,
  "version": "0.0.0",
  "description": "A voice assistant with a holographic browser HUD. The voice app runs on your own Claude Code login through a small local Node bridge, and it hands work to a team of Hermes agents that run on the AI model you choose.",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "bridge:writes": "node bridge/server.mjs --writes",
    "setup": "node scripts/setup.mjs",
    "add-agent": "node scripts/add-agent.mjs",
    "agents": "node scripts/agents.mjs",
    "remove-agent": "node scripts/remove-agent.mjs",
    "app": "electron desktop/main.mjs",
    "app:build": "node scripts/build-app.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.321",
    "@anthropic-ai/sdk": "^0.115.0",
    "@huggingface/transformers": "^3.8.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "kokoro-js": "^1.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^45.3.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
